# --- Server ---
PORT=3000
NODE_ENV=development
# Railway Postgresプラグイン追加時にRailwayが自動でDATABASE_URLを注入する。
# ローカル開発時はRailway PostgresのPublic Network URLをここに貼るか、ローカルPostgresを使う。
DATABASE_URL=postgresql://user:password@localhost:5432/postmanager

# 管理画面の簡易Basic認証
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me

# --- AI ---
ANTHROPIC_API_KEY=

# --- X (Twitter) API ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_CALLBACK_URL=http://localhost:3000/api/accounts/x/oauth/callback

# --- Instagram (Meta Graph API) ---
IG_APP_ID=
IG_APP_SECRET=
IG_OAUTH_CALLBACK_URL=http://localhost:3000/api/accounts/instagram/oauth/callback

# --- S3 (画像ストレージ) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api
