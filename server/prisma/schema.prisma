generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  x
  instagram
}

enum DraftStatus {
  draft
  scheduled
  posted
  failed
}

enum DraftSource {
  manual
  ai
  routine
}

enum RoutineFrequency {
  daily
  weekly
}

// post: 通常投稿 / quote: 過去投稿への引用リポスト(本文あり) / repost: 過去投稿の無言リポスト(本文なし)
enum PostMode {
  post
  quote
  repost
}

model Account {
  id                 String   @id @default(cuid())
  platform           Platform
  displayName        String
  handle             String
  oauthAccessToken   String?
  oauthRefreshToken  String?
  tokenExpiresAt     DateTime?
  platformUserId     String?
  igBusinessAccountId String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  drafts         Draft[]
  postMetrics    PostMetric[]
  accountMetrics AccountMetric[]
  dailyReports   DailyReport[]
  templates      Template[]
  routinePosts   RoutinePost[]

  @@unique([platform, handle])
}

// 「毎週月・木15時」「毎日9時」のように繰り返し投稿するルール。
// ワーカーが毎分チェックし、条件に合致したら実際のDraft(予約投稿)を生成する。
// 投稿処理自体は生成されたDraftを既存の予約投稿の仕組みに乗せて実行するため、
// 二重投稿防止やリトライなどは新たに実装しない。
model RoutinePost {
  id                String           @id @default(cuid())
  accountId         String
  account           Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  text              String
  mediaUrls         String[]         @default([])
  frequency         RoutineFrequency @default(weekly)
  // frequency=weeklyの場合のみ使用。0=日,1=月,2=火,3=水,4=木,5=金,6=土
  daysOfWeek        Int[]            @default([])
  hour              Int
  minute            Int
  active            Boolean          @default(true)
  // その日(JST)にもう発火したかどうかの判定用。同じ日に二重生成しないためのガード
  lastTriggeredDate DateTime?        @db.Date
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Template {
  id        String   @id @default(cuid())
  title     String
  body      String
  mediaUrls String[] @default([])
  // nullなら「共通」テンプレート(全アカウントに表示)、指定があればそのアカウント専用
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  drafts Draft[]
}

model Draft {
  id             String      @id @default(cuid())
  accountId      String
  account        Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform       Platform
  text           String
  mediaUrls      String[]    @default([])
  status         DraftStatus @default(draft)
  scheduledAt    DateTime?
  postedAt       DateTime?
  source         DraftSource @default(manual)
  templateId     String?
  template       Template?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  postMode       PostMode    @default(post)
  quoteTargetId  String?
  lastError      String?
  retryCount     Int         @default(0)
  // 「今すぐ投稿」の連打やワーカーとの同時実行による二重投稿を防ぐための排他フラグ
  postInProgress Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  postLogs PostLog[]

  @@index([status, scheduledAt])
}

model PostLog {
  id             String   @id @default(cuid())
  draftId        String
  draft          Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  platformPostId String?
  status         String
  errorMessage   String?
  executedAt     DateTime @default(now())
}

model PostMetric {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform       Platform
  platformPostId String
  // リポスト(無言リポスト)の場合、Xのリポストレスポンスに新規ツイートIDが
  // 含まれないため、本文を引くための元投稿IDをここに保持する
  sourcePostId   String?
  // 投稿自体の日時(Xのcreated_at)。指標収集を実行した日時(capturedAt)とは別。
  // これが無いと「最近投稿された順」に並べられず、収集タイミング次第で
  // 古い投稿が表示されてしまう
  postedAt       DateTime?
  likes          Int      @default(0)
  reposts        Int      @default(0)
  replies        Int      @default(0)
  impressions    Int      @default(0)
  saves          Int      @default(0)
  capturedAt     DateTime @default(now())
}

model AccountMetric {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform       Platform
  followersCount Int      @default(0)
  profileViews   Int      @default(0)
  reach          Int      @default(0)
  capturedAt     DateTime @default(now())
}

model DailyReport {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reportDate        DateTime @db.Date
  reviewText        String
  improvementsText  String
  nextActionsText   String
  createdAt         DateTime @default(now())

  @@unique([reportDate, accountId])
}
